{
  "name": "fx-ui",
  "version": "0.2.5",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot app.tsx",
    "build": "bun build --compile --asset-naming=\"[name].[ext]\" app.tsx node_modules/libfx/libfx.darwin-arm64.node node_modules/libfx/fx-core.wasm node_modules/libfx/fx-term.wasm node_modules/@gpuix/native-darwin-arm64/gpuix-native.darwin-arm64.node --outfile dist/fx",
    "package": "bun scripts/package.ts",
    "screenshot": "bun screenshot.ts",
    "test": "rm -rf .tmp-test-home && FX_UI_HOME=.tmp-test-home vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gpuix/native": "0.10.0",
    "@gpuix/react": "0.10.0",
    "jsonc-parser": "^3.3.1",
    "libfx": "^0.0.11",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/react": "^19.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.18"
  },
  "patchedDependencies": {
    "libfx@0.0.11": "patches/libfx@0.0.11.patch"
  }
}
