+    #[napi]
+    pub fn prompt_for_paths(&self, element_id: f64, multiple: bool) -> Result<()> {
+        #[cfg(target_os = "macos")]
+        {
+            let callback = self.event_callback_for_view();
+            update_window(move |_view, _window, cx| {
+                let chosen = cx.prompt_for_paths(gpui::PathPromptOptions {
+                    files: true,
+                    directories: false,
+                    multiple,
+                    prompt: None,
+                });
+                cx.spawn(async move |_, _| {
+                    if let Ok(Ok(Some(paths))) = chosen.await {
+                        let value = paths
+                            .iter()
+                            .map(|path| path.to_string_lossy().into_owned())
+                            .collect::<Vec<_>>()
+                            .join("\n");
+                        emit_event_full(&callback, element_id as u64, "change", |payload| {
+                            payload.value = Some(value);
+                        });
+                    }
+                })
+                .detach();
+            })
+        }
+
+        #[cfg(not(target_os = "macos"))]
+        {
+            let _ = (element_id, multiple);
+            Err(Error::from_reason("prompt_for_paths is only wired up on macOS"))
+        }
+    }
